{
  "name": "huggingface-hello-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "sync-model": "node scripts/sync-model.mjs",
    "typecheck": "tsc --noEmit",
    "build:apk": "expo prebuild -p android --no-install && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "postinstall": "patch-package"
  },
  "private": true
}
